# Copie para .env (que não é versionado): cp .env.example .env
# Todos os valores abaixo são exclusivamente de desenvolvimento.

# Versão gravada no binário e na tag da imagem local.
APP_VERSION=dev
LOG_LEVEL=info

# Credenciais locais (dev-only).
POSTGRES_PASSWORD=dev-only-change-me
RABBITMQ_PASSWORD=dev-only-change-me
# Segredos HMAC do webhook, separados por vírgula (o primeiro é o atual; os
# demais ficam aceitos durante a rotação).
WEBHOOK_SECRETS=whsec_dev_only_change_me

# Operadores do painel (operador:papel:token, separados por vírgula; papel leitor ou operador). Cada token é de
# uma pessoa: a regra dos quatro olhos exige operadores diferentes (ADR 0011).
OPERATOR_TOKENS=ana:operador:dev-token-ana,bruno:operador:dev-token-bruno,carla:leitor:dev-token-carla

# Autenticação OIDC (ADR 0013): com OIDC_ISSUER_URL definido os tokens acima não valem. APP_ENV=production recusa
# OPERATOR_TOKENS. As roles são do realm (platform-edge): payments.write vira operador e payments.read, leitor.
# APP_ENV=dev
# OIDC_ISSUER_URL=http://localhost:8080/realms/edge
# OIDC_AUDIENCE=edge-gateway
# OIDC_ROLE_READER=payments.read
# OIDC_ROLE_OPERATOR=payments.write
# Painel: OIDC_AUTHORITY (o emissor como o navegador o vê) e OIDC_CLIENT_ID (client público com PKCE).
# Suba com `make up-oidc`: o override zera OPERATOR_TOKENS e repassa estas variáveis à API e ao painel.

# gRPC interno de saldo (ADR 0016): GRPC_ADDR liga; em production exige GRPC_TLS_CERT_FILE e GRPC_TLS_KEY_FILE.
# GRPC_ADDR=:9091

# Segredos por cofre (ADR 0014): SECRETS_PROVIDER=vault|awssm troca WEBHOOK_SECRETS por uma referência e permite
# rotação sem reiniciar. Com o LocalStack: `make up-secrets`.
# SECRETS_PROVIDER=env
# WEBHOOK_SECRETS_REF=payments/webhook        (Vault: caminho#campo; Secrets Manager: id ou id#campo)
# DATABASE_PASSWORD_REF=payments/db#password
# SECRETS_REFRESH_INTERVAL=1m
# SECRETS_ENDPOINT=http://localhost:4567      (Secrets Manager no LocalStack)
# VAULT_ADDR=http://localhost:8200            (VAULT_TOKEN só em dev; em produção VAULT_K8S_ROLE)

# Traces: preenchido automaticamente por `make up-observability`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Portas no host, escolhidas para não colidir com os outros projetos do ecossistema.
API_PORT=8085
GRPC_PORT=9191
WEB_PORT=8086
POSTGRES_PORT=5434
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673
LOCALSTACK_PORT=4567
REDIS_PORT=6381
RELAY_OPS_PORT=9101
CONSUMER_OPS_PORT=9102
JAEGER_UI_PORT=16687
PROMETHEUS_PORT=9095

# Limite de webhooks por lojista e janela (baixo no ambiente local para a demo).
WEBHOOK_RATE_LIMIT=20
WEBHOOK_RATE_WINDOW=1m

# Dia conciliado por `make reconcile`.
RECONCILE_DATE=2026-11-20

# --- Variáveis lidas pelo binário (já definidas no docker-compose) ---
# DATABASE_URL=postgres://payments:dev-only-change-me@localhost:5434/payments?sslmode=disable
# RABBITMQ_URL=amqp://payments:dev-only-change-me@localhost:5673/
# HTTP_ADDR=:8080
# OPS_ADDR=:9090
# WEBHOOK_SIGNATURE_TOLERANCE=5m
# OUTBOX_BATCH_SIZE=100
# OUTBOX_POLL_INTERVAL=1s
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_BACKOFF_BASE=1s
# OUTBOX_BACKOFF_MAX=5m
# PUBLISH_CONFIRM_TIMEOUT=5s
# CONSUMER_PREFETCH=10
# CONSUMER_RETRY_BASE=500ms
# CONSUMER_RETRY_MAX=10s
# CONSUMER_DELIVERY_LIMIT=5
# STATEMENTS_BUCKET=pagafacil-statements
# S3_ENDPOINT=http://localhost:4567
# S3_USE_PATH_STYLE=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# REDIS_URL=redis://localhost:6381/0   (vazio: sem atalho de idempotência nem limite)
# IDEMPOTENCY_CLAIM_TTL=30s
# IDEMPOTENCY_DONE_TTL=24h
# SHUTDOWN_TIMEOUT=15s
